# .env.example = a TEMPLATE for your secrets file. It is committed to Git; it has no real keys.
#
# How to use:
#   1. Copy this file and name the copy ".env"   (Copy-Item .env.example .env)
#   2. Fill in the values in .env
#   3. NEVER commit .env (it is listed in .gitignore). On Render, set the same names
#      under Environment instead.
#
# The LLM chain: PRIMARY (Groq) -> FALLBACK (local Ollama) -> extractive answer (no LLM).
# Everything still works WITHOUT any LLM: the FAQ bot then reads out the best-matching FAQ
# answer word for word, and Step 8 part (a) is skipped.

# ---- PRIMARY LLM ------------------------------------------------------------------------
# My choice: Groq (free tier with per-minute and per-day limits).
#   Key from https://console.groq.com (API Keys). Your exact limits: Groq console > Settings > Limits.
#   llama-3.1-8b-instant    = fastest, highest daily limit on the free tier (good for Step 8's many calls)
#   llama-3.3-70b-versatile = smarter, but lower daily limits
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant

# ---- FALLBACK LLM (used only when the primary fails) ------------------------------------
# Ollama: free, runs on this laptop, nothing leaves the machine (slower on a CPU).
#   Install Ollama, then:  ollama pull llama3.2:3b   (Ollama must be running)
# Leave these EMPTY on Render: the free server is far too small to run a local LLM.
FALLBACK_LLM_BASE_URL=http://localhost:11434/v1
FALLBACK_LLM_API_KEY=ollama
FALLBACK_LLM_MODEL=llama3.2:3b

# ---- Other PRIMARY options (replace the 3 PRIMARY lines above) ---------------------------

# Option C: Google Gemini (has a free tier). Key from Google AI Studio.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=<a current "flash" model name from Google's docs>

# Option D: OpenAI (paid). Leave LLM_BASE_URL empty.
# LLM_BASE_URL=
# LLM_API_KEY=sk-...
# LLM_MODEL=<a current small model name from OpenAI's pricing page>

# Prices per 1 million tokens of the PRIMARY, ONLY used to estimate cost in Step 8.
# 0 for Groq's free tier and Ollama. (To estimate what a PAID plan would cost, put the
# provider's published prices here.)
LLM_PRICE_INPUT_PER_1M=0
LLM_PRICE_OUTPUT_PER_1M=0

# ---- Database for request logs ----------------------------------------------------------
# Leave this commented out locally: the app then uses a SQLite file (request_log.db).
# On Render this is filled in automatically from the Render PostgreSQL database.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
